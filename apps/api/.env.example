# cp .env.example .env
# Docker: compose читает этот файл (db, api, migrate). MYSQL_HOST для контейнеров подменяется на db.

MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=build_journal

JWT_SECRET=dev-jwt-secret-min-32-characters-long
JWT_REFRESH_SECRET=dev-refresh-secret-min-32-chars
JWT_ACCESS_EXPIRES_SECONDS=900
JWT_REFRESH_EXPIRES_IN=7d

PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173
