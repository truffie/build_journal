generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "mysql"
}

enum UserRole {
  ADMIN
  MANAGER
  FOREMAN
  BRIGADIER
  WORKER
}

enum ProjectStatus {
  ACTIVE
  COMPLETED
  SUSPENDED
}


model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  fullName     String   @map("full_name")
  role         UserRole
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  createdProjects       Project[]             @relation("ProjectCreatedBy")
  projectAssignments    ProjectAssignment[]   @relation("AssignmentUser")
  assignedProjects      ProjectAssignment[]   @relation("AssignmentAssignedBy")
  createdJournals       WorkJournal[]         @relation("JournalCreatedBy")
  createdJournalEntries JournalEntry[]        @relation("JournalEntryCreatedBy")
  performedEntries      JournalEntry[]        @relation("JournalEntryWorker")
  refreshTokens         RefreshToken[]

  @@map("users")
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model Project {
  id          String        @id @default(uuid())
  name        String
  address     String?
  status      ProjectStatus @default(ACTIVE)
  createdById String        @map("created_by_id")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  createdBy   User                @relation("ProjectCreatedBy", fields: [createdById], references: [id])
  assignments ProjectAssignment[]
  journals    WorkJournal[]

  @@map("projects")
}

model ProjectAssignment {
  id           String    @id @default(uuid())
  projectId    String    @map("project_id")
  userId       String    @map("user_id")
  assignedById String    @map("assigned_by_id")
  assignedAt   DateTime  @default(now()) @map("assigned_at")
  revokedAt    DateTime? @map("revoked_at")

  project    Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user       User    @relation("AssignmentUser", fields: [userId], references: [id], onDelete: Cascade)
  assignedBy User    @relation("AssignmentAssignedBy", fields: [assignedById], references: [id])

  @@unique([projectId, userId])
  @@index([userId, revokedAt])
  @@index([projectId, revokedAt])
  @@map("project_assignments")
}

model WorkJournal {
  id          String        @id @default(uuid())
  projectId   String   @map("project_id")
  title       String?
  createdById String   @map("created_by_id")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")
  deletedAt   DateTime?     @map("deleted_at")

  project   Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy User           @relation("JournalCreatedBy", fields: [createdById], references: [id])
  entries   JournalEntry[]

  @@index([projectId])
  @@index([projectId, deletedAt])
  @@map("work_journals")
}

model WorkType {
  id          Int     @id @default(autoincrement())
  name        String  @unique
  defaultUnit String  @map("default_unit")
  sortOrder   Int     @map("sort_order")
  isActive    Boolean @default(true) @map("is_active")

  @@map("work_types")
}

model JournalEntry {
  id                 String    @id @default(uuid())
  journalId          String    @map("journal_id")
  workDate           DateTime  @map("work_date") @db.Date
  workTypeSnapshot   String    @map("work_type_snapshot")
  unitSnapshot       String    @map("unit_snapshot")
  volume             Decimal   @db.Decimal(10, 2)
  workerId           String?   @map("worker_id")
  workerNameSnapshot String    @map("worker_name_snapshot")
  orderIndex         Int       @map("order_index")
  locationSection    String?   @map("location_section")
  locationFloor      String?   @map("location_floor")
  locationAxes       String?   @map("location_axes")
  conditionsText     String?   @map("conditions_text")
  notes              String?   @db.Text
  createdById        String    @map("created_by_id")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")
  deletedAt          DateTime? @map("deleted_at")

  journal   WorkJournal @relation(fields: [journalId], references: [id], onDelete: Cascade)
  worker    User?       @relation("JournalEntryWorker", fields: [workerId], references: [id], onDelete: SetNull)
  createdBy User        @relation("JournalEntryCreatedBy", fields: [createdById], references: [id])

  @@index([journalId, workDate, orderIndex])
  @@index([journalId, deletedAt, workDate])
  @@index([deletedAt])
  @@map("journal_entries")
}
